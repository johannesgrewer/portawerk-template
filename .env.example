# [FIRMENNAME] — Umgebungsvariablen
# Kopiere diese Datei zu .env, falls ein Werkzeug sie braucht. .env NIE committen.
#
# Die Seite selbst braucht hier nichts. Alle Geheimnisse sind Worker-Secrets
# und werden nur per wrangler gesetzt, nie in eine Datei im Repo:
#
#   printf '%s' "$KEY" | npx wrangler secret put BREVO_API_KEY         # Formular (Build)
#   printf '%s' "$KEY" | npx wrangler secret put TURNSTILE_SECRET_KEY  # Bot-Schutz (Build)
#   printf '%s' "$KEY" | npx wrangler secret put CANARY_TOKEN          # Monitor (Build, beim Livegang neu ableiten)
#   printf '%s' "$KEY" | npx wrangler secret put CANARY_TO_EMAIL       # Monitor (Build)
#   printf '%s' "$KEY" | npx wrangler secret put ERS_API_KEY           # Rechtstexte (Livegang)
#   printf '%s' "$KEY" | npx wrangler secret put PIRSCH_ZUGANG         # Messung (Livegang)
#
# Empfaenger und Absender des Formulars sind keine Geheimnisse und stehen als
# "vars" in wrangler.jsonc (CONTACT_TO_EMAIL, CONTACT_FROM_EMAIL, ALLOWED_ORIGIN).
#
# `npm run rechtstexte` liest den easyRechtssicher-Schluessel aus
# ~/.claude/secrets/<datei>, Dateiname steht in rechtstexte.config.mjs.
