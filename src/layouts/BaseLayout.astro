---
/**
 * BaseLayout.astro — Grundgeruest jeder Seite.
 * Bindet Tokens, Base-CSS, SEO, Schema, Icons, Fonts, Skip-Link ein.
 * Gezaehlt wird serverseitig im Worker (worker/index.ts), nicht hier.
 * Genau eine H1 pro Seite kommt aus dem Seiteninhalt (Slot).
 *
 * Zwei Schalter aus site.ts:
 * - notdienst: Telefonleiste unten auf dem Handy (Telefonleiste.astro)
 * - pitchLeiste: PortaWerk-Leiste der Vorschau, NUR AB 900 PX. Auf dem Handy
 *   verdeckte sie bei HGS die Telefonleiste und den halben ersten Schirm.
 *   Beim Livegang den Eintrag in site.ts loeschen, damit ist sie weg und die
 *   CSP-Freigabe (sicherheit.ts) gleich mit.
 */
import '../config/tokens.css';
import '../styles/globals.css';
import Seo from '../seo/Seo.astro';
import LocalBusiness from '../seo/LocalBusiness.astro';
import SkipToContent from '../components/SkipToContent.astro';
import Telefonleiste from '../components/Telefonleiste.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  /** Name der Seite in der Brotkrumenleiste (Schema). Ohne Angabe auf
   *  Unterseiten der Titel bis zum "|", false = keine Brotkrumen (404). */
  brotkrumen?: string | false;
}

const {
  title,
  description,
  ogImage,
  canonical = Astro.url.href,
  noindex = false,
  brotkrumen,
} = Astro.props;

// Brotkrumen nur auf Unterseiten, die Startseite ist selbst der Anfang.
const istStartseite = new URL(canonical).pathname === '/';
const brotkrumenName =
  istStartseite || brotkrumen === false ? undefined : (brotkrumen ?? title.split(' | ')[0]);

const leiste = site.pitchLeiste;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Markiert, dass JS laeuft. Erst dann darf CSS Inhalte fuer die
         Scroll-Animation ausblenden (siehe .js .animate-on-scroll). */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} noindex={noindex} />

    {/* Icons. Im Starter liegen neutrale Platzhalter in public/, der
         Rauchtest warnt, solange sie drin sind. Pro Kunde aus dem Signet neu
         bauen (Befehl: references/portawerk-standards, Favicon). */}
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="icon" type="image/png" href="/icon-512.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {/* Web-Manifest (gebaut aus site.ts, src/pages/site.webmanifest.ts) und
         Farbe der Browserleiste = --c-bg. */}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={site.themeFarbe} />

    {/* Font-Preload (self-hosted). TODO(pro Kunde): Pfade auf die gewaehlten Fonts
         setzen und aktivieren. Nur was oben sofort sichtbar ist, Italic laedt bei Bedarf nach.
    <link rel="preload" href="/fonts/[display-font]/[display-font]-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/[body-font]/[body-font]-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    */}

    <LocalBusiness titel={title} beschreibung={description} url={canonical} brotkrumen={brotkrumenName} />

    {/* Seiten koennen zusaetzliche head-Tags einschieben */}
    <slot name="head" />
  </head>

  <body>
    <SkipToContent />
    <slot />

    {site.notdienst && <Telefonleiste />}

    {/* IntersectionObserver fuer Scroll-Animationen (.animate-on-scroll) */}
    <script>
      const zielElemente = document.querySelectorAll('.animate-on-scroll');
      const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || ruhig) {
        // Kein Observer oder kein Bewegungswunsch: alles sofort zeigen, nie
        // unsichtbar stehen lassen.
        zielElemente.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        zielElemente.forEach((el) => observer.observe(el));
      }
    </script>

    {leiste && (
      <script is:inline define:vars={{ kunde: leiste.kunde, token: leiste.token, klassen: leiste.klassen ?? '' }}>
        // Nur ab 900 px einhaengen, am Handy bleibt die Vorschau frei.
        if (window.matchMedia('(min-width: 900px)').matches) {
          const skript = document.createElement('script');
          skript.src = 'https://cockpit.portawerk.de/leiste.js';
          skript.defer = true;
          skript.dataset.kunde = kunde;
          skript.dataset.token = token;
          if (klassen) skript.dataset.klassen = klassen;
          document.body.appendChild(skript);
        }
      </script>
    )}
  </body>
</html>
