---
/**
 * GalerieBuehne.astro — ein grosses Bild, darunter eine Reihe Miniaturen.
 *
 * Die Variante, die bei Ferienwohnungen und Immobilien erwartet wird: man
 * sieht ein Bild in Ruhe UND behaelt den Ueberblick, weil alle anderen als
 * Vorschau darunter stehen. Jedes Bild ist direkt anspringbar, man muss sich
 * nicht durchklicken wie im Karussell.
 *
 * Progressive Enhancement: Die Miniaturen sind echte Links auf die grosse
 * Datei. Ohne JS zeigt die Buehne das erste Bild und ein Klick auf eine
 * Miniatur oeffnet das Bild direkt. Mit JS wechselt er die Buehne.
 */
import { Image } from 'astro:assets';
import { Expand } from '@lucide/astro';
import type { ImageMetadata } from 'astro';

interface Eintrag {
  bild: ImageMetadata;
  alt: string;
  gross: string;
}

interface Props {
  bilder: Eintrag[];
  gruppe?: string;
}

const { bilder, gruppe = 'buehne' } = Astro.props;
const erstes = bilder[0];
---
<div class="bu" data-buehne>
  {erstes && (
    <figure class="bu__buehne">
      {/* Bewusst ein einfaches <img> statt <Image>: die Quelle wird beim
          Wechseln per Skript getauscht, dafuer braucht es eine feste URL.
          Die Dateien sind bereits optimierte WebP aus derselben Pipeline. */}
      <button class="bu__lupe" type="button" data-bu-oeffnen aria-label="Bild groß ansehen">
        <Expand size={20} stroke-width={1.75} aria-hidden="true" />
      </button>
      <img
        class="bu__bild"
        data-bu-bild
        src={erstes.gross}
        alt={erstes.alt}
        width="1600"
        height="1067"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="bu__text" data-bu-text aria-live="polite">{erstes.alt}</figcaption>
    </figure>
  )}

  <ul class="bu__reihe">
    {bilder.map((eintrag, index) => (
      <li>
        {/* data-alt traegt die Bildbeschreibung fuer die Buehne: das
            Vorschaubild selbst hat alt="", damit der Link nicht doppelt
            angesagt wird. */}
        <a
          href={eintrag.gross}
          data-lightbox={gruppe}
          data-bu-mini
          data-index={index}
          data-alt={eintrag.alt}
          class:list={['bu__mini', { 'is-aktiv': index === 0 }]}
          aria-label={`Bild ${index + 1} von ${bilder.length}: ${eintrag.alt}`}
        >
          <Image
            src={eintrag.bild}
            alt=""
            widths={[120, 240]}
            width={240}
            sizes="120px"
            quality={68}
            loading="lazy"
          />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .bu__buehne {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--c-border);
  }

  .bu__bild {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
    /* Sanfter Wechsel beim Umschalten. Die Klasse setzt das Skript. */
    transition: opacity var(--duration-normal) var(--ease-smooth);
  }
  .bu__bild.is-wechsel { opacity: 0; }

  /* Bildbeschreibung liegt auf dem Bild, nicht darunter: darunter wuerde sie
     die Miniaturenreihe wegschieben, sobald der Text zweizeilig wird. */
  .bu__text {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-lg) var(--space-md) var(--space-md);
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--c-white);
    background: linear-gradient(to top, rgba(12, 13, 15, 0.78) 0%, rgba(12, 13, 15, 0) 100%);
    text-shadow: 0 1px 8px rgba(10, 11, 13, 0.6);
  }

  .bu__lupe {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: var(--radius-full);
    background: rgba(26, 23, 20, 0.55);
    backdrop-filter: blur(4px);
    color: var(--c-white);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-smooth);
  }
  .bu__lupe:hover { background: rgba(26, 23, 20, 0.75); }
  .bu__lupe:focus-visible { outline: 2px solid var(--c-white); outline-offset: 2px; }

  /* ── Miniaturen ── */
  .bu__reihe {
    list-style: none;
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    /* Bei vielen Bildern waagerecht scrollbar statt umbrechend: eine zweite
       Reihe wuerde die Buehne aus dem Bild schieben. */
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .bu__mini {
    display: block;
    flex: 0 0 96px;
    overflow: hidden;
    border-radius: var(--radius-md);
    /* Platz fuer den Rahmen der aktiven Miniatur freihalten, sonst wackelt
       die Reihe beim Umschalten. */
    outline: 2px solid transparent;
    outline-offset: 2px;
    opacity: 0.55;
    transition: opacity var(--duration-fast) var(--ease-smooth),
                outline-color var(--duration-fast) var(--ease-smooth);
  }
  .bu__mini:hover { opacity: 1; }
  .bu__mini.is-aktiv {
    opacity: 1;
    outline-color: var(--c-accent);
  }
  .bu__mini:focus-visible { outline-color: var(--c-accent-text); }

  .bu__mini :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 700px) {
    .bu__mini { flex: 0 0 116px; }
    .bu__text { font-size: var(--fs-body); padding: var(--space-xl) var(--space-lg) var(--space-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bu__bild, .bu__mini { transition: none; }
  }
</style>

<script>
  /**
   * Wechselt das Buehnenbild, wenn eine Miniatur angeklickt wird. Die
   * Lightbox bleibt zustaendig fuer die Vollansicht - der Knopf auf der
   * Buehne loest dafuer einfach die aktive Miniatur aus, statt eine zweite
   * Verdrahtung zur Lightbox zu bauen.
   */
  document.querySelectorAll<HTMLElement>('[data-buehne]').forEach((kasten) => {
    const bild = kasten.querySelector<HTMLImageElement>('[data-bu-bild]');
    const text = kasten.querySelector<HTMLElement>('[data-bu-text]');
    const minis = Array.from(kasten.querySelectorAll<HTMLAnchorElement>('[data-bu-mini]'));
    const oeffnen = kasten.querySelector<HTMLButtonElement>('[data-bu-oeffnen]');

    if (!bild || minis.length === 0) return;

    let aktuell = 0;

    const zeigen = (index: number) => {
      const mini = minis[index];
      if (!mini) return;
      aktuell = index;

      bild.classList.add('is-wechsel');
      bild.src = mini.href;
      // Die Beschreibung steht als data-alt am Miniatur-Link. Das alt des
      // Vorschaubildes ist leer, damit der Link nicht doppelt angesagt wird.
      const alt = mini.dataset.alt ?? '';
      bild.alt = alt;
      if (text) text.textContent = alt;

      minis.forEach((m, i) => m.classList.toggle('is-aktiv', i === index));
    };

    bild.addEventListener('load', () => bild.classList.remove('is-wechsel'));
    if (bild.complete) bild.classList.remove('is-wechsel');

    minis.forEach((mini, index) => {
      mini.addEventListener('click', (ereignis) => {
        if (ereignis.metaKey || ereignis.ctrlKey || ereignis.shiftKey || ereignis.button !== 0) return;
        // Erster Klick wechselt nur die Buehne. Erst ein Klick auf die
        // Buehne selbst oeffnet die Vollansicht - sonst kaeme man nie zum
        // ruhigen Betrachten, weil jeder Klick die Lightbox aufreisst.
        if (index !== aktuell) {
          ereignis.preventDefault();
          ereignis.stopImmediatePropagation();
          zeigen(index);
        }
        // Bei der bereits aktiven Miniatur laeuft das Ereignis weiter zur
        // Lightbox, die daran haengt.
      });
    });

    oeffnen?.addEventListener('click', () => minis[aktuell]?.click());
  });
</script>
