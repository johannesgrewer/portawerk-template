---
/**
 * GalerieRaster.astro — gleichformatige Kacheln im Raster.
 *
 * Die ruhigste und schnellste Variante: alles auf einen Blick, kein
 * Bedienelement, kein Skript ausser der Lightbox. Der Preis ist, dass kein
 * Bild hervorsticht - bei einer festen Dramaturgie (Rundgang) ist das ein
 * Vorteil, bei einem starken Leitmotiv ein Nachteil.
 *
 * Einheitliches 4:3 statt der Originalformate: die Fotos kommen aus
 * verschiedenen Kameras, ungleiche Kacheln lassen das Raster unruhig
 * aussehen.
 */
import { Image } from 'astro:assets';
import { Expand } from '@lucide/astro';
import type { ImageMetadata } from 'astro';

interface Eintrag {
  bild: ImageMetadata;
  alt: string;
  gross: string;
}

interface Props {
  bilder: Eintrag[];
  gruppe?: string;
}

const { bilder, gruppe = 'raster' } = Astro.props;
---
<ul class="ra">
  {bilder.map((eintrag) => (
    <li class="animate-on-scroll">
      <a href={eintrag.gross} data-lightbox={gruppe}>
        <Image
          src={eintrag.bild}
          alt={eintrag.alt}
          widths={[400, 800]}
          width={800}
          sizes="(min-width: 900px) 30vw, (min-width: 600px) 46vw, 92vw"
          {/* Kacheln sind hoechstens 30vw breit, da traegt 68 problemlos
              und halbiert das Gewicht der laubreichen Aussenmotive. */}
          quality={68}
          loading="lazy"
        />
        <span class="ra__lupe" aria-hidden="true">
          <Expand size={20} stroke-width={1.75} />
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .ra {
    list-style: none;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: 1fr;
  }

  .ra li {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--c-border);
  }
  /* Der Fokusring sitzt am li, nicht am Link: das li schneidet mit
     overflow: hidden alles ab, was aus der Kachel ragt. */
  .ra li:has(a:focus-visible) {
    outline: 2px solid var(--c-accent-text);
    outline-offset: 3px;
  }

  .ra a { display: block; position: relative; }

  .ra :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    transition: transform 1.2s var(--ease-smooth);
  }
  .ra li:hover :global(img) { transform: scale(1.04); }

  .ra__lupe {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(26, 23, 20, 0.55);
    backdrop-filter: blur(4px);
    color: var(--c-white);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-smooth),
                transform var(--duration-normal) var(--ease-smooth);
  }
  .ra a:hover .ra__lupe,
  .ra a:focus-visible .ra__lupe { opacity: 1; transform: none; }
  /* Auf Touchgeraeten gibt es kein Hover - dort steht das Zeichen dauerhaft. */
  @media (hover: none) {
    .ra__lupe { opacity: 1; transform: none; }
  }

  @media (min-width: 600px) { .ra { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) {
    .ra { grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ra :global(img) { transition: none; }
    .ra li:hover :global(img) { transform: none; }
  }
</style>
