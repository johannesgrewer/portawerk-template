---
/**
 * Lightbox.astro — Vollbildansicht fuer die Galerie.
 *
 * Progressive Enhancement: Die Galerie-Kacheln sind echte <a>-Links auf die
 * grosse Bilddatei. Ohne JS oeffnet ein Klick schlicht das Bild, mit JS
 * faengt dieses Skript den Klick ab und zeigt es hier.
 *
 * Basis ist das native <dialog> mit showModal(). Das erledigt Fokusfalle,
 * ESC zum Schliessen und das Inert-Setzen des Hintergrunds von selbst -
 * alles Dinge, die eine selbstgebaute Overlay-Loesung erfahrungsgemaess
 * halb vergisst.
 */
import { X, ChevronLeft, ChevronRight } from '@lucide/astro';
---
{/* tabindex="-1" macht den Dialog programmatisch fokussierbar. Das Skript
    setzt den Fokus beim Oeffnen auf ihn statt auf den Schliessen-Knopf,
    sonst zieht der dort einen sichtbaren Ring, obwohl mit der Maus
    geoeffnet wurde. Screenreader lesen so beim Oeffnen das aria-label,
    Tab springt danach regulaer auf den ersten Knopf. */}
<dialog class="lb" id="lightbox" aria-label="Galerie, grosse Ansicht" tabindex="-1">
  <button class="lb__knopf lb__knopf--zu" type="button" data-lb-zu aria-label="Ansicht schliessen">
    <X size={22} stroke-width={1.75} aria-hidden="true" />
  </button>

  <button class="lb__knopf lb__knopf--zurueck" type="button" data-lb-zurueck aria-label="Vorheriges Bild">
    <ChevronLeft size={26} stroke-width={1.75} aria-hidden="true" />
  </button>

  <figure class="lb__buehne">
    {/* aria-live: Blaettern tauscht nur das Bild aus, ohne Ansage bliebe der
        Wechsel fuer Screenreader stumm. */}
    {/* Bewusst ohne src: ein leeres src-Attribut laesst den Browser die
        Seite selbst als Bild anfordern. Die Quelle setzt das Skript. */}
    <img class="lb__bild" alt="" decoding="async" />
    <figcaption class="lb__unterschrift" aria-live="polite">
      <span class="lb__zaehler"></span>
      <span class="lb__alt"></span>
    </figcaption>
  </figure>

  <button class="lb__knopf lb__knopf--vor" type="button" data-lb-vor aria-label="Naechstes Bild">
    <ChevronRight size={26} stroke-width={1.75} aria-hidden="true" />
  </button>
</dialog>

<style>
  /* Der Dialog ist die ganze Flaeche. Rahmen und Innenabstand des Browsers
     muessen weg, sonst sitzt ein weisser Kasten um das Bild. */
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--c-text);
    overflow: hidden;
  }

  /* Der Dialog traegt den Fokus nur als Startpunkt, er ist selbst kein
     Bedienelement - ein Ring um die ganze Flaeche waere sinnlos. */
  .lb:focus { outline: none; }

  /* Weisser Grund statt der dunklen Box: die Fotos stehen dadurch wie
     Abzuege auf einem Blatt, nicht in einem Kinosaal. Nicht ganz deckend,
     damit man merkt, dass die Seite darunter weiterlaeuft. */
  .lb::backdrop {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
  }

  .lb[open] {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  /* ── Buehne ── */
  .lb__buehne {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .lb__bild {
    max-width: 100%;
    /* Rest der Hoehe nach Unterschrift und Innenabstand. Ein fester Wert
       liesse auf flachen Fenstern die Bildunterschrift aus dem Bild laufen. */
    max-height: calc(100svh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    /* Auf Weiss wird ein kraeftiger Schatten schmutzig. Ein knapper,
       warm getoenter reicht, um das Bild von der Flaeche zu loesen. */
    box-shadow: 0 18px 48px rgba(31, 27, 24, 0.16);
  }

  /* Beim Blaettern kurz ausblenden, damit kein halb geladenes Bild aufblitzt.
     Die Klasse setzt das Skript, sie geht beim load-Ereignis wieder weg. */
  .lb__bild.is-wechsel { opacity: 0; }
  .lb__bild {
    transition: opacity var(--duration-normal) var(--ease-smooth);
  }

  .lb__unterschrift {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    text-align: center;
    max-width: 62ch;
  }

  /* Der Zaehler war ein farbiger Chip und zog damit mehr Aufmerksamkeit als
     das Foto. Jetzt eine gesperrte Ziffernfolge in Grau - sie informiert,
     ohne mitzureden. */
  .lb__zaehler {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--c-text-muted);
  }

  .lb__alt {
    font-size: var(--fs-small);
    line-height: var(--lh-normal);
    color: var(--c-text-muted);
  }

  /* ── Knoepfe ── */
  .lb__knopf {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    background: var(--c-white);
    color: var(--c-text);
    cursor: pointer;
    transition: box-shadow var(--duration-fast) var(--ease-smooth),
                border-color var(--duration-fast) var(--ease-smooth),
                transform var(--duration-fast) var(--ease-smooth);
  }
  /* Hover = Mehr. Auf weissem Grund geht "heller" nicht, also mehr Praesenz:
     kraeftigere Kante und ein angehobener Schatten. */
  .lb__knopf:hover {
    border-color: var(--c-text-muted);
    box-shadow: var(--shadow-md);
  }
  .lb__knopf:active { transform: scale(0.94); }
  /* --c-accent-text: der Ring steht auf dem weissen Grund der Lightbox,
     ein heller Akzent waere dort kaum sichtbar. */
  .lb__knopf:focus-visible {
    outline: 2px solid var(--c-accent-text);
    outline-offset: 3px;
  }
  .lb__knopf[disabled] { opacity: 0.35; cursor: default; }
  .lb__knopf[disabled]:hover {
    border-color: var(--c-border);
    box-shadow: none;
  }

  /* Der Schliessen-Knopf sitzt ueber allem in der Ecke, nicht im Raster. */
  .lb__knopf--zu {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 2;
  }

  /* ── Auftritt ── */
  @media (prefers-reduced-motion: no-preference) {
    .lb[open] { animation: lb-auf var(--duration-normal) var(--ease-out); }
    .lb[open]::backdrop { animation: lb-grund var(--duration-normal) var(--ease-smooth); }
  }

  @keyframes lb-auf {
    from { opacity: 0; transform: scale(0.97); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes lb-grund {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Mobile ──
     Die seitlichen Pfeile fressen auf schmalen Schirmen die Bildbreite auf.
     Dort liegen sie deshalb als Paar unter der Unterschrift, und gewischt
     wird ohnehin. */
  @media (max-width: 639px) {
    .lb[open] {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      /* align-content statt align-items: die beiden Zeilen ruecken als Paket
         in die Mitte. Sonst zieht jede Zeile ihren Anteil an der vollen
         Fensterhoehe und die Pfeile stehen einsam ganz unten. */
      align-content: center;
      justify-items: center;
      padding: var(--space-sm);
    }
    /* Buehne und Pfeilzeile explizit setzen, sonst verteilt die
       automatische Platzierung die drei Kinder auf drei Zeilen. */
    .lb__buehne { grid-row: 1; grid-column: 1; }
    .lb__bild { max-height: calc(100svh - 15rem); }
    /* Beide Pfeile in dieselbe Zeile, links und rechts aussen. */
    .lb__knopf--zurueck, .lb__knopf--vor {
      grid-row: 2;
      grid-column: 1;
      margin-top: var(--space-md);
    }
    .lb__knopf--zurueck { justify-self: start; }
    .lb__knopf--vor { justify-self: end; }
  }
</style>

<script>
  /**
   * Bindet alle Galerie-Links an den Dialog.
   *
   * Die Liste kommt aus dem DOM, nicht aus einer zweiten Datenquelle: was in
   * der Galerie steht, ist automatisch das, was die Lightbox zeigt. Kommt ein
   * Bild dazu, muss hier nichts nachgezogen werden.
   *
   * GRUPPEN: Der Wert von data-lightbox trennt Bildstrecken voneinander.
   * Stehen zwei Galerien auf einer Seite, blaettert man sonst aus der einen
   * in die andere und der Zaehler zeigt die Summe beider ("5 / 18").
   * Gleicher Wert = gleiche Strecke, leerer Wert = eigene Standardstrecke.
   */
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
  const alleAusloeser = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]')
  );

  // Ohne Dialog oder ohne Bilder bleiben die Links normale Links auf die Datei.
  if (dialog && alleAusloeser.length > 0) {
    const bild = dialog.querySelector<HTMLImageElement>('.lb__bild')!;
    const zaehler = dialog.querySelector<HTMLElement>('.lb__zaehler')!;
    const beschriftung = dialog.querySelector<HTMLElement>('.lb__alt')!;
    const knopfZurueck = dialog.querySelector<HTMLButtonElement>('[data-lb-zurueck]')!;
    const knopfVor = dialog.querySelector<HTMLButtonElement>('[data-lb-vor]')!;
    const knopfZu = dialog.querySelector<HTMLButtonElement>('[data-lb-zu]')!;

    // Quelle und Beschreibung stehen am Link selbst, das alt am Vorschaubild.
    const strecke = (gruppe: string) =>
      alleAusloeser
        .filter((link) => (link.dataset.lightbox ?? '') === gruppe)
        .map((link) => ({
          link,
          quelle: link.href,
          text: link.querySelector('img')?.alt ?? '',
        }));

    // Wird beim Oeffnen auf die Strecke des angeklickten Bildes gesetzt.
    let bilder = strecke('');
    let aktuell = 0;

    /** Laedt das Nachbarbild vor, damit Blaettern ohne Warten laeuft. */
    const vorladen = (index: number) => {
      const eintrag = bilder[index];
      if (!eintrag) return;
      const puffer = new Image();
      puffer.src = eintrag.quelle;
    };

    const zeigen = (index: number) => {
      const eintrag = bilder[index];
      if (!eintrag) return;
      aktuell = index;

      bild.classList.add('is-wechsel');
      bild.src = eintrag.quelle;
      bild.alt = eintrag.text;
      zaehler.textContent = `${index + 1} / ${bilder.length}`;
      beschriftung.textContent = eintrag.text;

      // Am Anfang und am Ende ist Schluss. Ein Rundlauf waere hier irrefuehrend:
      // die Galerie ist ein Rundgang mit Anfang und Ende, kein Karussell.
      knopfZurueck.disabled = index === 0;
      knopfVor.disabled = index === bilder.length - 1;

      vorladen(index + 1);
      vorladen(index - 1);
    };

    // Erst wenn die Datei da ist, wird wieder eingeblendet. `complete` faengt
    // den Fall ab, dass das Bild schon im Cache liegt und load nie feuert.
    bild.addEventListener('load', () => bild.classList.remove('is-wechsel'));
    if (bild.complete) bild.classList.remove('is-wechsel');

    const oeffnen = (gruppe: string, index: number) => {
      bilder = strecke(gruppe);
      zeigen(index);
      dialog.showModal();
      // showModal fokussiert von sich aus den ersten Knopf. Der Fokus gehoert
      // aber auf den Dialog selbst, sonst steht ein Ring auf dem X.
      dialog.focus();
      // showModal macht den Hintergrund inert, sperrt aber das Scrollen
      // dahinter nicht. Ohne das hier wandert die Seite unter dem Dialog weg.
      document.documentElement.style.overflow = 'hidden';
    };

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      // Fokus zurueck auf die Kachel, aus der geoeffnet wurde. Der Link steht
      // am Eintrag selbst, damit das auch nach dem Blaettern stimmt.
      bilder[aktuell]?.link.focus();
    });

    alleAusloeser.forEach((link) => {
      link.addEventListener('click', (ereignis) => {
        // Modifiziertes Klicken gehoert dem Browser: neuer Tab, Speichern.
        if (ereignis.metaKey || ereignis.ctrlKey || ereignis.shiftKey || ereignis.button !== 0) return;
        ereignis.preventDefault();
        const gruppe = link.dataset.lightbox ?? '';
        // Position INNERHALB der eigenen Strecke, nicht im gesamten Dokument.
        const index = strecke(gruppe).findIndex((eintrag) => eintrag.link === link);
        oeffnen(gruppe, index === -1 ? 0 : index);
      });
    });

    knopfZurueck.addEventListener('click', () => zeigen(aktuell - 1));
    knopfVor.addEventListener('click', () => zeigen(aktuell + 1));
    knopfZu.addEventListener('click', () => dialog.close());

    // ESC erledigt der Dialog selbst, hier fehlen nur die Pfeiltasten.
    dialog.addEventListener('keydown', (ereignis) => {
      if (ereignis.key === 'ArrowRight') { ereignis.preventDefault(); zeigen(aktuell + 1); }
      if (ereignis.key === 'ArrowLeft')  { ereignis.preventDefault(); zeigen(aktuell - 1); }
    });

    // Klick auf den freien Grund schliesst. Der Dialog fuellt das Fenster,
    // deshalb wird geprueft, ob der Klick ausserhalb von Bild und Knoepfen lag.
    dialog.addEventListener('click', (ereignis) => {
      const ziel = ereignis.target as HTMLElement;
      if (ziel === dialog || ziel.classList.contains('lb__buehne')) dialog.close();
    });

    // ── Wischen auf dem Handy ──
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('touchstart', (ereignis) => {
      startX = ereignis.changedTouches[0].clientX;
      startY = ereignis.changedTouches[0].clientY;
    }, { passive: true });

    dialog.addEventListener('touchend', (ereignis) => {
      const wegX = ereignis.changedTouches[0].clientX - startX;
      const wegY = ereignis.changedTouches[0].clientY - startY;
      // Nur waagerechte Gesten zaehlen, sonst blaettert jedes Scrollen mit.
      if (Math.abs(wegX) < 50 || Math.abs(wegX) < Math.abs(wegY)) return;
      zeigen(wegX < 0 ? aktuell + 1 : aktuell - 1);
    }, { passive: true });
  }
</script>
