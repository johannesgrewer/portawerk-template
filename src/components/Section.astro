---
/**
 * Section.astro — gemeinsamer Wrapper fuer alle Inhaltssektionen (Haut).
 * Definiert vertikalen Rhythmus, Container-Breite und Hintergrundvariante
 * an EINER Stelle, damit die Seite einen ruhigen, einheitlichen Takt hat.
 * Nur Tokens, keine festen Pixel.
 */
interface Props {
  background?: 'default' | 'surface' | 'accent' | 'dark';
  spacing?: 'normal' | 'tight' | 'loose';
  container?: 'default' | 'narrow' | 'wide';
  id?: string;
}

const {
  background = 'default',
  spacing = 'normal',
  container = 'default',
  id,
} = Astro.props;

const containerClass = container === 'default' ? 'container' : `container container-${container}`;
---
<section id={id} class:list={['pw-section', `bg-${background}`, `sp-${spacing}`]}>
  <div class={containerClass}>
    <slot />
  </div>
</section>

<style>
  .pw-section { width: 100%; }

  /* ── Vertikaler Rhythmus (nur Tokens) ── */
  .sp-tight  { padding-block: var(--space-xl); }
  .sp-normal { padding-block: var(--section-py); }
  .sp-loose  { padding-block: calc(var(--section-py) + var(--space-2xl)); }

  /* ── Hintergrundvarianten ── */
  .bg-default { background: var(--c-bg); }
  .bg-surface { background: var(--c-surface); }
  .bg-accent  { background: var(--c-accent); color: var(--c-white); }
  .bg-dark    { background: var(--c-primary); color: var(--c-white); }

  /* Ueberschriften erben auf dunklen/farbigen Flaechen die helle Textfarbe
     (globals.css setzt sonst explizit --c-text). :global, weil der Inhalt
     ueber <slot> reinkommt. */
  .bg-dark :global(h1), .bg-dark :global(h2), .bg-dark :global(h3), .bg-dark :global(h4),
  .bg-accent :global(h1), .bg-accent :global(h2), .bg-accent :global(h3), .bg-accent :global(h4) {
    color: var(--c-white);
  }
</style>
