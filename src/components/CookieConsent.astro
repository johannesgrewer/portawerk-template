---
/**
 * CookieConsent.astro — MINIMALER Consent-Banner.
 * NUR einbinden, wenn wirklich einwilligungspflichtige Dienste dazukommen.
 * Bei reinem Cloudflare Web Analytics (cookielos) + self-hosted Fonts ist er NICHT noetig.
 * Speichert die Wahl in localStorage; feuert 'pw-consent'-Event bei Zustimmung.
 */
interface Props {
  services?: string[];   // Namen der einwilligungspflichtigen Dienste
}
const { services = [] } = Astro.props;
const serviceLabel = services.length ? services.join(', ') : 'externe Dienste';
---
<div class="pw-consent-banner" role="dialog" aria-live="polite" aria-label="Cookie-Hinweis" hidden>
  <p>
    Diese Website nutzt {serviceLabel}, die erst nach Ihrer Zustimmung geladen werden.
  </p>
  <div class="pw-consent-actions">
    <button type="button" class="btn btn-primary" data-consent="accept">Zustimmen</button>
    <button type="button" class="btn btn-ghost" data-consent="decline">Ablehnen</button>
  </div>
</div>

<style>
  .pw-consent-banner {
    position: fixed;
    left: 50%;
    bottom: var(--space-md);
    transform: translateX(-50%);
    width: min(92%, 640px);
    z-index: 200;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    font-size: var(--fs-small);
  }
  .pw-consent-actions { display: flex; gap: var(--space-sm); }
</style>

<script>
  const KEY = 'pw-consent';
  const banner = document.querySelector<HTMLElement>('.pw-consent-banner');
  if (banner) {
    const stored = localStorage.getItem(KEY);
    if (!stored) banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.consent === 'accept' ? 'accepted' : 'declined';
        localStorage.setItem(KEY, val);
        banner.hidden = true;
        if (val === 'accepted') {
          document.dispatchEvent(new CustomEvent('pw-consent', { detail: { status: 'accepted' } }));
        }
      });
    });
  }
</script>
