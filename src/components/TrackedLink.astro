---
import type { EventName } from "../lib/tracking";

interface Props {
  event: EventName;
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { event, href, class: className, ...rest } = Astro.props;
---
<a href={href} class:list={[`pirsch-event=${event}`, className]} {...rest}>
  <slot />
</a>
