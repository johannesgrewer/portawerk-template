---
/**
 * datenschutz.astro — Datenschutzerklaerung von easyRechtssicher, siehe
 * Rechtstext.astro. Ohne Notfall-Fassung steht nur der Verantwortliche da und
 * ein Hinweis, dass die Erklaerung aktualisiert wird. Bewusst kein selbst
 * geschriebener Entwurf: Rechtstexte sagen wir inhaltlich nie zu.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rechtstext from '../components/Rechtstext.astro';
import { site } from '../config/site';

// Nur Werte aus site.ts, keine Eingaben von aussen.
const platzhalter = [
  '<h2>Verantwortlicher</h2>',
  `<p>${site.legal.inhaber}<br>${site.name.replace(/&/g, '&amp;')}<br>${site.address.strasse}, ${site.address.plz} ${site.address.ort}<br>`,
  `E-Mail: <a href="mailto:${site.email}">${site.email}</a><br>Telefon: <a href="tel:+${site.telefonRaw}">${site.telefon}</a></p>`,
  '<p>Die Datenschutzerkl&auml;rung wird gerade aktualisiert. Fragen zum Datenschutz beantworten wir Ihnen gern unter den oben genannten Kontaktdaten.</p>',
].join('');
---
<BaseLayout
  title={`Datenschutz | ${site.name}`}
  description={`Datenschutzerklärung von ${site.name}.`}
  noindex={true}
>
  <Header />
  <main id="main-content" class="legal-page">
    <div class="container container-narrow">
      <h1>Datenschutzerkl&auml;rung</h1>
      <Rechtstext art="datenschutz" ersatz={platzhalter} />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    background: var(--c-bg);
  }
  h1 { margin-bottom: var(--space-lg); }
</style>
