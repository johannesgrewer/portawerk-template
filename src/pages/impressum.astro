---
/**
 * impressum.astro — Impressum von easyRechtssicher, siehe Rechtstext.astro.
 * Ohne Notfall-Fassung steht eine knappe Fassung aus site.ts mit den
 * Pflichtangaben nach § 5 DDG da.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rechtstext from '../components/Rechtstext.astro';
import { site } from '../config/site';

// Nur Werte aus site.ts, keine Eingaben von aussen. Das & im Firmennamen wird maskiert.
const kurzfassung = [
  '<h2>Angaben gem&auml;&szlig; &sect; 5 DDG</h2>',
  `<p>${site.legal.inhaber}<br>${site.name.replace(/&/g, '&amp;')}<br>${site.address.strasse}<br>${site.address.plz} ${site.address.ort}</p>`,
  '<h2>Kontakt</h2>',
  `<p>Telefon: <a href="tel:+${site.telefonRaw}">${site.telefon}</a><br>E-Mail: <a href="mailto:${site.email}">${site.email}</a></p>`,
  site.legal.ustId
    ? `<h2>Umsatzsteuer-ID</h2><p>Umsatzsteuer-Identifikationsnummer gem&auml;&szlig; &sect; 27 a Umsatzsteuergesetz: ${site.legal.ustId}</p>`
    : '',
].join('');
---
<BaseLayout
  title={`Impressum | ${site.name}`}
  description={`Impressum und Angaben gemäß § 5 DDG für ${site.name}.`}
  noindex={true}
>
  <Header />
  <main id="main-content" class="legal-page">
    <div class="container container-narrow">
      <h1>Impressum</h1>
      <Rechtstext art="impressum" ersatz={kurzfassung} />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-page {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    background: var(--c-bg);
  }
  h1 { margin-bottom: var(--space-lg); }
</style>
