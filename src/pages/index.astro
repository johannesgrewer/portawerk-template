---
/**
 * index.astro — Startseite.
 * Fundament: BaseLayout + Header + Footer stehen fest.
 * Die HAUT (Hero + Content-Sektionen) wird pro Kunde frei gebaut und
 * hier in <main> eingesetzt. Unten ein minimales Platzhalter-Beispiel,
 * damit der Starter sofort baut.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Kontakt from '../components/Kontakt.astro';
import { site } from '../config/site';
---
<BaseLayout
  title={`${site.name} | ${site.slogan}`}
  description="TODO: individuelle Meta-Description (max. 155 Zeichen) pro Kunde."
>
  <Header />
  <main id="main-content">
    <!-- ══════════════════════════════════════════════════════════
         HAUT — hier kommt der Kundeninhalt rein (Hero + Sektionen).
         Frei gebaut pro Kunde. Extraktion in die Bibliothek erst
         nach der Drittel-Regel. Das Folgende ist nur Platzhalter.
         ══════════════════════════════════════════════════════════ -->
    <section class="section" id="start">
      <div class="container">
        <p class="badge">PortaWerk Starter-Fundament</p>
        <h1>{site.name}</h1>
        <p>{site.slogan}</p>
        <a href={site.cta.href} class="btn btn-primary">{site.cta.label}</a>
        {/* data-anruf-primaer: Solange dieser Knopf im Bild ist, bleibt die
            Telefonleiste (nur bei site.notdienst) unten weg. */}
        <a href={`tel:+${site.telefonRaw}`} class="btn btn-secondary" data-anruf-primaer>{site.telefon}</a>
      </div>
    </section>

    {/* Rohbau: Technik fest, Optik pro Kunde frei. Fragen.astro bei Bedarf
        davor einsetzen: <Fragen fragen={[{ frage: '...', antwort: '...' }]} /> */}
    <Kontakt class="bg-surface" />
  </main>
  <Footer />
</BaseLayout>
