# @portawerk-Pakete kommen aus der privaten Registry der Organisation.
# Hier steht bewusst KEIN Token: npm liest Zugangsdaten ohnehin nur aus der
# Benutzer-Konfiguration, nicht aus dieser Datei im Projekt.
#
# Einmalig auf einem neuen Rechner:
#   npm config set //npm.pkg.github.com/:_authToken "$(gh auth token)"
# In GitHub Actions genuegt:
#   NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
@portawerk:registry=https://npm.pkg.github.com
