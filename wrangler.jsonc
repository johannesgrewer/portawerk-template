{
  // Cloudflare Worker mit Static Assets (nicht Cloudflare Pages, Pages wird
  // von Cloudflare nur noch gepflegt). Muster Ordnung Trier, ohne Astro-Adapter.
  //
  // PRO KUNDE ANPASSEN: "projekt-slug" in name und Route ersetzen (Vorschau-Subdomain,
  // gleich site.vorschau). Nie ein nacktes *.workers.dev verlinken.
  //
  // VORAUSSETZUNG: Die Domain muss als Zone bei Cloudflare liegen. Fuer die
  // Vorschau ist das portawerk.de, fuer den Livegang die Kundendomain. Liegt
  // die Kundendomain zwingend bei einem Fremdanbieter: www per Custom Hostname
  // ueber Cloudflare for SaaS (globale CLAUDE.md, Punkt 0).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projekt-slug-preview",
  "compatibility_date": "2026-07-27",

  // Eigener Einstieg: Formular, Rechtstexte, Sicherheits-Header, Zaehlung.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Seiten und /api laufen zuerst durch den Worker, die Dateiordner aus
    // dist/ nicht (spart Aufrufe, fuer sie gilt public/_headers). Ordner je
    // Projekt aus dist/ ablesen.
    "run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/images/*"]
  },
  "routes": [
    { "pattern": "projekt-slug.portawerk.de", "custom_domain": true }
  ],
  // Die Seite darf nicht zusaetzlich unter *.workers.dev stehen (doppelter Inhalt).
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }

  // ════════════════════════════════════════════════════════════════════
  // VORBEREITET. Im Pitch bleibt alles hier unten aus. Beim Build bzw.
  // Livegang den jeweiligen Block oben vor die schliessende Klammer
  // ziehen (Komma nicht vergessen). worker/index.ts prueft jede Bindung
  // und laeuft ohne sie weiter.
  // ════════════════════════════════════════════════════════════════════
  //
  // ── 1. Kontaktformular (Build) ─────────────────────────────────────
  // Keine Geheimnisse, stehen bewusst offen, damit man im Pull Request
  // sieht, wohin ein Formular schreibt. ALLOWED_ORIGIN = Adresse, von der
  // die Seite gerade laeuft (Vorschau, beim Livegang die Kundendomain).
  //   "vars": {
  //     "CONTACT_TO_EMAIL": "info@[kunde].de",
  //     "CONTACT_FROM_EMAIL": "formular@[kunde].de",
  //     "ALLOWED_ORIGIN": "https://projekt-slug.portawerk.de"
  //   },
  // Rate-Limit ueber die Bindung statt KV (kostenlos, kein Schreibkontingent).
  // namespace_id je Konto eindeutig waehlen.
  //   "ratelimits": [
  //     { "name": "FORM_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
  //     { "name": "CANARY_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  //   ],
  // Ergebnisprotokoll (nur Zaehler), eigener Durable Object, nie ein KV.
  //   "durable_objects": {
  //     "bindings": [{ "name": "FORM_PROTOKOLL", "class_name": "FormularProtokoll" }]
  //   },
  //   "migrations": [{ "tag": "formular-protokoll-v1", "new_sqlite_classes": ["FormularProtokoll"] }],
  // Secrets:
  //   printf '%s' "$KEY" | npx wrangler secret put BREVO_API_KEY
  //   printf '%s' "$KEY" | npx wrangler secret put TURNSTILE_SECRET_KEY   (erst nach dem Site-Key in site.ts)
  //   printf '%s' "$KEY" | npx wrangler secret put CANARY_TOKEN           (fuer den Host abgeleitet, /portawerk-build Phase 4)
  //   printf '%s' "$KEY" | npx wrangler secret put CANARY_TO_EMAIL
  //
  // ── 2. Rechtstexte (Livegang, /portawerk-deliver Phase 2) ───────────
  // KV-Namensraum anlegen (npx wrangler kv namespace create RECHTSTEXTE),
  // nur fuer die Rechtstexte, nie mit etwas anderem teilen.
  //   "kv_namespaces": [{ "binding": "RECHTSTEXTE", "id": "[id]" }],
  // Einmal taeglich holen (UTC). Crons brauchen eine workers.dev-Subdomain
  // am Konto, die Seite selbst bleibt dort trotzdem aus (workers_dev: false).
  //   "triggers": { "crons": ["17 3 * * *"] },
  //   printf '%s' "$KEY" | npx wrangler secret put ERS_API_KEY
  //
  // ── 3. Kundendomain (Livegang) ──────────────────────────────────────
  // Routen ersetzen, account_id des Kundenkontos eintragen, in
  // worker/index.ts HAUPT_HOST und ZAEHL_HOSTS fuellen.
  //   "account_id": "[kunden-account-id]",
  //   "routes": [
  //     { "pattern": "[kunde].de", "custom_domain": true },
  //     { "pattern": "www.[kunde].de", "custom_domain": true }
  //   ],
  //   printf '%s' "$KEY" | npx wrangler secret put PIRSCH_ZUGANG
  //   printf '%s' "$KEY" | npx wrangler secret put CANARY_TOKEN   (fuer die Kundendomain neu abgeleitet)
  //
  // ── Erweiterung: Astro-Adapter (nur wenn Astro selbst rendern muss) ──
  // Etwa fuer live abgerufene Google-Bewertungen. Muster HGS Becker,
  // Anleitung in CLAUDE.md. Nicht ungefragt einbauen.
}
